# Kreo Hive 65 (SinoWealth 258a:010c): let the logged-in user configure the
# keyboard (hidraw) and read its key events for typing effects (evdev).
KERNEL=="hidraw*", ATTRS{idVendor}=="258a", ATTRS{idProduct}=="010c", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{idVendor}=="258a", ATTRS{idProduct}=="010c", MODE="0666", TAG+="uaccess"
